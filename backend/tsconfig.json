{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Environment Settings */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",  // <-- Thêm dòng này để TS tự động tìm module thông minh hơn
    "target": "ES2022",
    "lib": ["esnext"],

    /* Other Outputs */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Stricter Typechecking Options */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Interop Constraints */
    "esModuleInterop": true,         // <-- Thêm dòng này để import các thư viện CommonJS mượt mà
    "forceConsistentCasingInFileNames": true,

    /* Recommended Options */
    "skipLibCheck": true
    
    // Tạm thời tắt hoặc xóa dòng "verbatimModuleSyntax": true đi để ts-node không bị bắt bẻ cú pháp import
  },
  "include": ["src/**/*"]            // <-- Thêm dòng này ở ngoài compilerOptions để TS quét đúng thư mục code
}